#!/usr/bin/env bash
set -euo pipefail

commit_msg_file="$1"
subject="$(head -n 1 "$commit_msg_file" | tr -d '\r')"

# Allow standard merge commits
if [[ "$subject" == Merge\ * ]]; then
  exit 0
fi

regex='^(feat|fix|docs|chore|ci|refactor|perf|test)(\([a-z0-9._-]+\))?!?: .+'

if [[ ! "$subject" =~ $regex ]]; then
  echo "" >&2
  echo "[Error] Invalid commit message format: '$subject'" >&2
  echo "Expected Conventional Commits format: <type>(<scope>): <description>" >&2
  echo "Allowed types: feat, fix, docs, chore, ci, refactor, perf, test" >&2
  echo "Example: feat(cli): add --check-deps flag" >&2
  echo "" >&2
  exit 1
fi